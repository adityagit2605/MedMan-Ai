# ── Database ──────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/healthcare
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_strong_db_password

# ── Redis ─────────────────────────────────────────────────────
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
APP_JWT_SECRET=replace_with_64_byte_base64_encoded_secret
APP_JWT_ACCESS_TOKEN_EXPIRY_MS=900000
APP_JWT_REFRESH_TOKEN_EXPIRY_MS=604800000

# ── CORS ──────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── LLM Service ───────────────────────────────────────────────
APP_LLM_SERVICE_URL=http://localhost:8000

# ── Slot Hold ─────────────────────────────────────────────────
APP_SLOT_HOLD_MINUTES=5
APP_SLOT_REDIS_LOCK_TTL_MS=5000
